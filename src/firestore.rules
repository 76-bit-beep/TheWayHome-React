
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'qCMUIllRSgRmTucv7Tlqz5PJ3gl2';
    }

    function validManualBooking() {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'guestName',
          'email',
          'phone',
          'guests',
          'checkIn',
          'checkOut',
          'status',
          'source',
          'notes',
          'createdAt'
        ])
        && data.keys().hasAll([
          'guestName',
          'guests',
          'checkIn',
          'checkOut',
          'status',
          'source',
          'createdAt'
        ])
        && data.guestName is string
        && data.guestName.size() > 0
        && data.guestName.size() <= 120
        && data.guests is int
        && data.guests >= 1
        && data.guests <= 5
        && data.checkIn is string
        && data.checkOut is string
        && data.checkIn.matches('\\d{4}-\\d{2}-\\d{2}')
        && data.checkOut.matches('\\d{4}-\\d{2}-\\d{2}')
        && data.checkIn < data.checkOut
        && data.status == 'confirmed'
        && data.source == 'manual'
        && data.createdAt == request.time
        && (!('email' in data)
          || (data.email is string && data.email.size() <= 254))
        && (!('phone' in data)
          || (data.phone is string && data.phone.size() <= 40))
        && (!('notes' in data)
          || (data.notes is string && data.notes.size() <= 2000));
    }

    function validPublicAvailability(nightId) {
      let data = request.resource.data;

      return data.keys().hasOnly([
          'bookingId',
          'status'
        ])
        && data.keys().hasAll([
          'bookingId',
          'status'
        ])
        && data.bookingId is string
        && data.bookingId.size() > 0
        && data.status == 'confirmed'
        && nightId.matches('\\d{4}-\\d{2}-\\d{2}');
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && validManualBooking();

      allow update: if false;

      allow delete: if isAdmin();
    }

    match /publicAvailability/{nightId} {
      allow read: if true;

      allow create: if isAdmin()
        && validPublicAvailability(nightId);

      allow update: if false;

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
